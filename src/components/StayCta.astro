const C = COPY[locale] ?? COPY.en;
const waHref = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(C.waMsg)}`;
---

<section class="bg-avorio" data-evt-view="stay_cta_view">
  <div class="mx-auto max-w-3xl px-6 pt-14 text-center lg:pt-20">
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-terracotta">{C.eyebrow}</p>
    <h2 class="mt-2 font-display text-3xl text-antracite lg:text-4xl">{title ?? C.h2}</h2>
    <p class="mt-4 leading-relaxed text-grigio">{subtitle ?? C.text}</p>
  </div>

  <BookingWidget locale={locale} subtitle={C.dates} />

  <div class="mx-auto max-w-3xl px-6 pb-14 text-center lg:pb-20">
    <a
      href={waHref}
      target="_blank"
      rel="noopener"
      data-evt="inquiry_click"
      data-evt-label="stay_cta_whatsapp"
      class="inline-flex items-center justify-center gap-2 rounded-full border border-antracite/15 bg-white px-6 py-3 font-medium text-antracite transition hover:border-antracite/30"
    >
      <Icon name="whatsapp" class="size-5" />
      {C.wa}
    </a>
    <p class="mt-4 text-sm text-grigio">{C.reassure}</p>
  </div>
</section>
