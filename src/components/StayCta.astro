---
/**
 * Blocco di conversione "Dove dormire" da mettere in fondo ai contenuti
 * informativi (guide turistiche, articoli del blog): spiega in due righe
 * cos'è Roma284, mostra il widget disponibilità e offre una via alternativa
 * al checkout (richiesta WhatsApp) per chi non vuole prenotare online.
 *
 * ATTENZIONE: contiene un BookingWidget, cioè l'unico #lodgify-search-bar
 * ammesso per pagina (l'init in Layout.astro usa getElementById). Se la
 * pagina ha già un BookingWidget, SOSTITUISCILO con questo componente.
 */
import BookingWidget from "./BookingWidget.astro";
import Icon from "./Icon.astro";
import { SITE } from "@lib/site";
import type { Locale } from "@i18n/config";

interface Props {
  locale?: Locale;
  /** Sostituisce il titolo di default del blocco. */
  title?: string;
  /** Sostituisce la riga sotto al titolo. */
  subtitle?: string;
}
const { locale = "it", title, subtitle } = Astro.props;

interface Copy {
  eyebrow: string;
  h2: string;
  text: string;
  dates: string;
  wa: string;
  waMsg: string;
  reassure: string;
}

